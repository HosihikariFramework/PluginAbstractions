<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Hosihikari</RootNamespace>
    <AssemblyName>Hosihikari.Plugin.Model</AssemblyName>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>Hosihikari.Plugin.Model</PackageId>
    <Version>3.0.0</Version>
    <Authors>HosihikariFramework</Authors>
    <Description>Plugin manifest model shared by the Hosihikari plugin manager and packer.</Description>
    <!-- 0.7.0 was published under LGPL; 0.7.1 and later are MIT. -->
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/HosihikariFramework/PluginAbstractions</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>minecraft;bedrock;bds;plugin;hosihikari</PackageTags>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

</Project>
