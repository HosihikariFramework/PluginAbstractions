<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <PackageType>Template</PackageType>
    <PackageId>Hosihikari.Plugin.Templates</PackageId>
    <Version>1.2.0</Version>
    <PackageVersion>1.2.0</PackageVersion>
    <Title>Hosihikari plugin templates</Title>
    <Authors>星光</Authors>
    <Description>dotnet new template for a precompiled Hosihikari plugin.</Description>
    <PackageTags>dotnet-new;templates;hosihikari;minecraft;bedrock</PackageTags>
    <PackageLicenseExpression>MIT-0</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/HosihikariFramework/PluginAbstractions</PackageProjectUrl>
    <RepositoryUrl>https://github.com/HosihikariFramework/PluginAbstractions.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IncludeContentInPack>true</IncludeContentInPack>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <ContentTargetFolders>content</ContentTargetFolders>
    <EnableDefaultItems>false</EnableDefaultItems>
    <NoDefaultExcludes>true</NoDefaultExcludes>
    <NoWarn>$(NoWarn);NU5110;NU5111;NU5128</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="Hosihikari.Plugin.Templates/**/*"
             Exclude="Hosihikari.Plugin.Templates/bin/**;Hosihikari.Plugin.Templates/obj/**;Hosihikari.Plugin.Templates/dist/**" />
    <Content Include="Hosihikari.Plugin.Templates.FSharp/**/*"
             Exclude="Hosihikari.Plugin.Templates.FSharp/bin/**;Hosihikari.Plugin.Templates.FSharp/obj/**;Hosihikari.Plugin.Templates.FSharp/dist/**" />
    <None Include="README.md" Pack="true" PackagePath="\" />
    <None Include="LICENSE.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
