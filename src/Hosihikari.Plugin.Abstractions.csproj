<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Hosihikari</RootNamespace>
    <AssemblyName>Hosihikari.Plugin.Abstractions</AssemblyName>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>Hosihikari.Plugin.Abstractions</PackageId>
    <Version>3.0.0</Version>
    <Authors>HosihikariFramework</Authors>
    <Description>Plugin contract for the Hosihikari framework: IPlugin, IPluginContext, IPluginLoader, host services and the plugin manifest model.</Description>
    <!-- 0.7.0 was published under LGPL; 0.7.1 and later are MIT. -->
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/HosihikariFramework/PluginAbstractions</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>minecraft;bedrock;bds;plugin;hosihikari</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <!-- 契约要有 XML 文档，引用方才有提示。 -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="../README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

  <ItemGroup>
    <!-- 清单模型与打包器共用（ADR-0059），所以是独立包；契约的签名还用到它，编译引用必须能传递到加载器作者。
         runtime 排除：模型随核心驻留共享层，插件包里不该再出现副本。 -->
    <ProjectReference Include="../model/Hosihikari.Plugin.Model.csproj" ExcludeAssets="runtime" />
  </ItemGroup>

  <ItemGroup>
    <!-- 只引抽象包（ADR-0007）：实现包留在 PluginManager，契约因此能驻留共享层。 -->
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.15" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.15" />
  </ItemGroup>

</Project>
