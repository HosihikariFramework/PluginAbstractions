<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="localpk" value="C:/Users/root/AppData/Local/Temp/pk" />
    <add key="localbuild" value="C:/Users/root/AppData/Local/Temp/pkbuild" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="localpk"><package pattern="*" /></packageSource>
    <packageSource key="localbuild"><package pattern="*" /></packageSource>
    <packageSource key="nuget.org"><package pattern="*" /></packageSource>
  </packageSourceMapping>
</configuration>
